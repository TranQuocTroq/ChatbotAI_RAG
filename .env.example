# Hugging Face Hub access token (write scope), used ONLY to persist app data
# (session metadata, FAISS/BM25 indices, uploaded documents) to a private HF Dataset repo.
# LLM inference is fully local and does NOT use this token.
HF_TOKEN=hf_your_huggingface_access_token_here

# Target Hugging Face Hub dataset repo used as the durable storage backend.
HF_DATASET_REPO_ID=your-username/docbrain-storage

# System settings
CONFIG_PATH=config/config.yaml
LOG_LEVEL=INFO
LLM_MODE=local_llm
